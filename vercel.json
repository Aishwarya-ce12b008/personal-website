{
  "framework": "astro",
  "buildCommand": "rm -rf .astro node_modules/.cache && npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aishwarya.work" }],
      "destination": "https://aishwarya.work/:path*",
      "permanent": true
    }
  ]
}
